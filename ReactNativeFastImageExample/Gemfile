source 'https://rubygems.org'

# Версии подобраны под ruby, который стоит на машинах проекта (4.x). Шаблонный
# Gemfile от react-native прижимает xcodeproj к `< 1.26.0`, а на ruby 4
# ставится только 1.27.0 — с ним `bundle install` падает, не дойдя до подов.
ruby '>= 3.2.0'

gem 'cocoapods', '>= 1.16', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '1.27.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4 вынес это из стандартной библиотеки.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
